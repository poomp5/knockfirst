{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    // Task file B2 says "moduleResolution": "node", but TypeScript 7 removed it (TS5108); the default resolution is used instead.
    "outDir": "dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src", "scripts"],
  "exclude": ["src/adapters"]
}
